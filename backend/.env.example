PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Legacy demo credentials (keep server-side only).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

FRONTEND_ORIGIN=http://localhost:5173
WEBHOOK_WORKER_INTERVAL_MS=2000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_REPLAY_WINDOW_SECONDS=600
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# RecoverAI SaaS / Razorpay Technology Partner OAuth
# Create these after Razorpay approves/registers your Technology Partner application.
RAZORPAY_OAUTH_CLIENT_ID=
RAZORPAY_OAUTH_CLIENT_SECRET=
RAZORPAY_OAUTH_REDIRECT_URI=https://YOUR_PUBLIC_BACKEND/api/razorpay/oauth/callback
RAZORPAY_OAUTH_MODE=test

# Public HTTPS endpoint that Razorpay will call for merchant webhooks.
# Example: https://YOUR_PUBLIC_BACKEND/api/webhooks/razorpay
PUBLIC_WEBHOOK_URL=
WEBHOOK_ALERT_EMAIL=

# 32 random bytes encoded as 64 hex characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
